# Dependencies are never committed.
node_modules/
.pnpm-store/
.npmrc.local

# Build scratch.
*.tsbuildinfo

# `lib/` IS committed, matching the other DSH plugins in this workspace
# (dsh-computer-use, dsh-tool-lazy-gate): a git-hosted install and a release
# tarball both need a runnable entry, and pnpm >= 10 refuses to run a
# dependency's build script. `npm run build` still regenerates it from `src/`,
# and CI can check the committed artifacts are current.
#
# Scratch directory created by examples/verify-exports.mjs.
.exports-check/

# Stray artifact from a settings/telemetry provider using an in-memory spec.
:memory:*
*.ses

# The implementation report for this project is a session artifact, not part of
# the plugin.
实施报告.md
